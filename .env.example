# SmartEd Africa — Root Environment Variables
# Used by docker-compose.yml
# Copy to .env and fill in all values before running `docker compose up`

# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGO_USER=smarted
MONGO_PASSWORD=change_this_strong_password

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=change_this_redis_password

# ── Backend JWT ──────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
REFRESH_SECRET=

# ── Email / SMTP ──────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@smarted.africa

# ── Paystack ──────────────────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=sk_test_...
PAYSTACK_PUBLIC_KEY=pk_test_...

# ── URLs ──────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:80
CORS_ORIGINS=http://localhost:80,http://localhost:5173

# ── Anthropic (AI Tutor service) ──────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001   # default — fast, cheap
# ANTHROPIC_MODEL=claude-sonnet-4-6           # higher quality, more expensive

# ── Vite build args (passed to frontend Docker build) ────────────────────────
VITE_API_URL=http://localhost:5000/api/v1
VITE_SENTRY_DSN=

# ── Cloudinary (for course image uploads) ────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Sentry (backend error tracking) ──────────────────────────────────────────
SENTRY_DSN=

# ── AI tutor (merged into backend) ───────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001  # default
# AI_SESSION_TTL=1800                         # seconds
# AI_MAX_HISTORY_TURNS=20

# ── Token expiry (optional — defaults shown) ──────────────────────────────────
# JWT_ACCESS_EXPIRES=15m
# REFRESH_EXPIRES_SECONDS=2592000  # 30 days

# ── Admin seeding (run: node backend/scripts/seedAdmin.js) ───────────────────
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=SmartEd Admin
